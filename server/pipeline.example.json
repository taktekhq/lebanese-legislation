{
  "format_version": 1,
  "state_dir": "/var/lib/legal-data-pipeline",
  "timezone": "Asia/Beirut",
  "daily_embedding_usd": "1",
  "embedding_usd_per_million": "0.15",
  "minimum_free_bytes": 42949672960,
  "admin_dsn_env": "PIPELINE_ADMIN_DSN",
  "reuse_dsn_env": "PIPELINE_REUSE_DSN",
  "hf_token_env": "HF_TOKEN",
  "reader_role": "lebleg_reader",
  "env_file": "/etc/legal-data-pipeline/private.env",
  "secret_files": {
    "HF_TOKEN": "/etc/legal-data-pipeline/hub-token",
    "GEMINI_API_KEY": "/etc/legal-data-pipeline/embedding-key"
  },
  "smoke_command": ["python3", "-m", "lebleg.pipeline_smoke"],
  "sources": [
    {"repo": "example/legal-data", "kind": "corpus", "card_block_file": "/var/lib/legal-data-pipeline/card-body.md"}
  ]
}
