#!/bin/sh
set -eu
cd "$(dirname "$0")"
image=${STARTER_IMAGE:-ghcr.io/taktekhq/lebanese-legislation-starter:0.1.0}
docker run --rm --user "$(id -u):$(id -g)" -v "$PWD:/workspace" -w /workspace "$image" init --env-file .env
docker compose up -d --wait --wait-timeout "${STARTUP_TIMEOUT:-7200}"
printf '%s\n' 'Ready. API and documentation: http://127.0.0.1:8000/docs (or your configured API_PORT).'
