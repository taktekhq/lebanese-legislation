[Unit]
Description=Lebanese Legislation: unofficial English of popular texts, one slice (cmd/translate-en, resumable)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/lebleg-translate
# One slice at a time; 2 workers and a 100-minute cap keep the agy seat from
# throttling (5 Nov: 4-6 workers for hours slowed calls past 4 minutes).
ExecStart=/usr/bin/flock -n %h/lebleg-translate/.lock /usr/bin/timeout 100m %h/lebleg-translate/translate-en -data %h/taktekhq/lebleg-seo/data -out article_en.jsonl -workers 2 -timeout 4m -model gemini-4-argon-low -agy %h/.local/bin/agy
SuccessExitStatus=1 3 124
StandardOutput=append:%h/lebleg-translate/run.log
StandardError=append:%h/lebleg-translate/run.log
Nice=5
