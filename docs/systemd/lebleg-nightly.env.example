# systemd EnvironmentFile syntax, no shell expansion. Use your absolute paths.
PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
LEBLEG_DSN="host=localhost dbname=lebleg"
LEBLEG_REPO=taktekhq/lebanese-legislation
# Optional: LEBLEG_STORE=/absolute/path/to/scraped-store
# Optional: LEBLEG_DATA=/absolute/path/to/output-data
# Optional: LEBLEG_LOCK_FILE=/absolute/path/to/nightly.lock
# Optional AI CLIs, already signed in. Empty paths skip model reading.
LEBLEG_AGY=
LEBLEG_CLAUDE=
# Optional SSH host for both CLIs; empty runs them locally.
LEBLEG_AI_REMOTE=
LEBLEG_JUDGE_MODEL=gemini-4-argon-medium
LEBLEG_CLAUDE_MODEL=sonnet
