# ./setup generates separate local passwords in a private .env file.
POSTGRES_PASSWORD=
READER_PASSWORD=
# Add your own key to turn on search by meaning. Exact and citation search need none.
GEMINI_API_KEY=
# Load vectors first (vectors/README.md), then point to lebleg_search:
# LEBLEG_VECTOR_DSN=host=db dbname=lebleg_search user=lebleg_reader password=${READER_PASSWORD}
# For Vectorize instead of pgvector, also set:
# CLOUDFLARE_ACCOUNT_ID=
# LEBLEG_VECTORIZE_TOKEN=
# LEBLEG_VECTORIZE_INDEX=
# Defaults are loopback only. Change ports if another local service uses them.
# DB_PORT=5433
# API_PORT=8000
# MCP_PORT=8001
# Requests a minute per client for the API and MCP when hosted publicly; 0 is no limit.
# RATE_LIMIT_PER_MINUTE=0
# Browser origins the MCP server answers, comma-separated.
# MCP_ALLOWED_ORIGINS=
# ALL_PORT=8080
# Your site address for absolute links, when you host the website publicly.
# PUBLIC_URL=https://your.mirror.example
# DB_IMAGE=ghcr.io/taktekhq/lebanese-legislation-db:latest
# API_IMAGE=ghcr.io/taktekhq/lebanese-legislation-api:latest
# MCP_IMAGE=ghcr.io/taktekhq/lebanese-legislation-mcp:latest
# ALL_IMAGE=ghcr.io/taktekhq/lebanese-legislation-all:latest

# DB_START_PERIOD=2h
# Containers and the volume are named after the Compose project.
# 0.1.x used lebleg-starter; set it to keep a database restored by 0.1.x.
# COMPOSE_PROJECT_NAME=lebanese-legislation
