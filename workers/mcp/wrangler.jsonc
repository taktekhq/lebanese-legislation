{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lebaneselegislation-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "observability": {
    "enabled": true
  },

  // Blue/green snapshot databases: deploy/snapshot.sh loads the one NOT
  // bound here, verifies it, then flips this binding's database_id and
  // redeploys, so the live MCP never reads a half-loaded database. Which
  // alias is live right now is also recorded in deploy/.d1-active.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lebleg-snapshot-a",
      "database_id": "bb130e21-9672-4b7f-9945-85c68ba360a3"
    }
  ],

  // Per-client-IP limit on /mcp: 60 requests/minute, see src/index.ts.
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    // About one PostHog event (mcp_rate_limited) per IP per minute for refusals.
    {
      "name": "MCP_REFUSAL_LOG",
      "namespace_id": "1002",
      "simple": { "limit": 1, "period": 60 }
    }
  ],

  // Daily at 03:17 UTC: the Hugging Face dataset's counters for PostHog
  // (src/hfstats.ts).
  "triggers": { "crons": ["17 3 * * *"] },

  // The MCP endpoint, on the site's own zone, so no separate domain to
  // remember: https://lebaneselegislation.com/mcp.
  //
  // /badge/* serves the live stat badges for the Hugging Face dataset card
  // and READMEs (src/badge.ts).
  "routes": [
    { "pattern": "lebaneselegislation.com/mcp", "zone_name": "lebaneselegislation.com" },
    { "pattern": "lebaneselegislation.com/badge/*", "zone_name": "lebaneselegislation.com" }
  ],

  // GA4 data streams in their own property, "lebaneselegislation.com MCP and
  // dataset" (561738177), one per source. Never point them at the website's
  // property (556959204, G-RDYRK422NP): machine calls then read as site
  // visitors. Each stream's
  // Measurement Protocol secret is a Worker secret, never in this file:
  //   npx wrangler secret put GA_MCP_API_SECRET
  //   npx wrangler secret put GA_HF_API_SECRET
  //
  // PostHog project LebaneseLegislation (312888, EU cloud): the project
  // token is public by design; the visitor-id salt is a Worker secret:
  //   npx wrangler secret put POSTHOG_ID_SALT
  "vars": {
    "GA_MCP_MEASUREMENT_ID": "G-J6B282V05W",
    "GA_HF_MEASUREMENT_ID": "G-TL4VC3TWQF",
    "POSTHOG_KEY": "phc_pTpSY5wVsQrG8LN58z4zWXdMWjvqR6uPCY2eXV25sBV5",
    "POSTHOG_HOST": "https://eu.i.posthog.com"
  }
}
